# Public Expo configuration; put these in apps/app/.env.local.
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
# Backend-only values: set with `pnpm exec convex env set NAME`.
# SITE_URL: PWA origin. AUTH_PUBLIC_URL: public Convex HTTP origin.
# BETTER_AUTH_SECRET, SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET
# Audio-native lane: DEEPGRAM_API_KEY (transcription),
# OPENROUTER_API_KEY (Jev line classification),
# REPLICATE_API_TOKEN (optional, vocal separation later).
# Never prefix any secret with EXPO_PUBLIC_.
PORT=3101
HOST=0.0.0.0
STATIC_DIR=../app/dist

# Optional app-server auth forwarding, in root .env.local (server-only).
AUTH_UPSTREAM_URL=

# Taddy podcast transcripts, in root .env.local (server-only).
TADDY_USER_ID=
TADDY_API_KEY=

# Optional single-track word-muting experiment; absolute path to prepare_rap.py output.
# Requires FFmpeg / ffprobe on the app server. Leave unset to disable the API.
RAP_TEST_CACHE_DIR=
