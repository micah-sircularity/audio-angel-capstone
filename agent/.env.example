FIREWORKS_API_KEY=
DEEPGRAM_API_KEY=
# Optional: Logfire write token. Without it, spans stay local.
LOGFIRE_TOKEN=
# Optional: override the default data dir (agent/data).
AUDIO_ANGEL_DATA_DIR=
# Podcasts are trimmed to this many minutes before transcription.
PODCAST_MAX_MINUTES=10
# Optional: deep link shown on the Monitor page.
LOGFIRE_PROJECT_URL=

# Vocal separation (Spleeter 2stems on a Modal T4, app
# `audio-angel-agent-separate`). music (default) | all | off
VOCAL_SEPARATION=music
# Modal creds — only needed when VOCAL_SEPARATION != off (or in Docker,
# where ~/.modal.toml isn't mounted). From `modal token new`.
#MODAL_TOKEN_ID=
#MODAL_TOKEN_SECRET=
